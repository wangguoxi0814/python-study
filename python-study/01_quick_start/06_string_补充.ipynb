    "## replace\n",
    "- 替换字符串，不改变原字符串,返回更换后的字符串"
   ],
   "id": "e4dd4c05a478a4ac"
  },
  {
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-08-05T09:02:09.911903600Z",
     "start_time": "2026-08-05T09:02:09.879664100Z"
    }
   },
   "cell_type": "code",
   "source": [
    "s1 = 'Hello World$$'\n",
    "print(s1.replace('$', '*'))\n",
    "print(s1)"
   ],
   "id": "cbe39ffeb6e1890e",
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Hello World**\n",
      "Hello World$$\n"
     ]
    }
   ],
   "execution_count": 2
  },
